<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.OidCrash" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color (Black/Dark Grey) -->
        <item name="colorPrimary">@color/oid_primary</item>
        <item name="colorPrimaryVariant">@color/oid_primary_variant</item>
        <item name="colorOnPrimary">@color/white</item>
        
        <!-- Secondary brand color (Red) -->
        <item name="colorSecondary">@color/oid_secondary</item>
        <item name="colorSecondaryVariant">@color/oid_secondary_variant</item>
        <item name="colorOnSecondary">@color/white</item>
        
        <!-- Status bar color -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        
        <!-- Default Button Style -->
        <item name="buttonStyle">@style/OidButtonStyle</item>
    </style>

    <!-- Custom Button Style -->
    <style name="OidButtonStyle" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/oid_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">8dp</item>
    </style>
</resources>